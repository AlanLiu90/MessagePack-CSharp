<#@ template debug="false" hostspecific="false" linePragmas="false" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>

using MsgPack = global::MessagePack;

[assembly: MsgPack::Internal.GeneratedAssemblyMessagePackResolverAttribute(typeof(<#= this.ResolverName.GetQualifiedName(Qualifiers.Namespace) #>), <#= Version.Parse(ThisAssembly.AssemblyFileVersion).Major #>, <#= Version.Parse(ThisAssembly.AssemblyFileVersion).Minor #>)]

<# using (TransformUtilities.EmitNestingTypesAndNamespaces(this.ResolverName, this.Write)) { #>

/// <summary>A MessagePack resolver that uses generated formatters for types in this assembly.</summary>
partial class <#= ResolverName.Name #> : MsgPack::IFormatterResolver
{
	/// <summary>An instance of this resolver that only returns formatters specifically generated for types in this assembly.</summary>
	public static readonly MsgPack::IFormatterResolver Instance = new <#= ResolverName.Name #>();

	private <#= ResolverName.Name #>()
	{
	}

	public MsgPack::Formatters.IMessagePackFormatter<T> GetFormatter<T>()
	{
		return FormatterCache<T>.Formatter;
	}

<#
   var constructedRegistrations = ConstructedTypeRegistrations.ToArray();
   var keyedRegistrations = GroupByRuntimeTypeKeyHash(constructedRegistrations, out var unkeyedRegistrations);
   var checkedRegistrations = new HashSet<int>(keyedRegistrations.Where(g => g.Count() > 1).SelectMany(g => g).Concat(unkeyedRegistrations));
   var openGenericRegistrations = OpenGenericRegistrations.ToArray();
#>
	private static class FormatterCache<T>
	{
		internal static readonly MsgPack::Formatters.IMessagePackFormatter<T> Formatter;

		static FormatterCache()
		{
<# if (constructedRegistrations.Length > 0) { #>
			// Closed types are found by a hash of their runtime name, so the formatter may belong to another type with
			// the same name (from another assembly, say). That formatter is not an IMessagePackFormatter<T>.
<#     if (openGenericRegistrations.Length > 0) { #>
			var formatter = <#= ResolverName.Name #>GetFormatterHelper.GetClosedFormatter(typeof(T)) as MsgPack::Formatters.IMessagePackFormatter<T>;
			Formatter = formatter ?? (MsgPack::Formatters.IMessagePackFormatter<T>)<#= ResolverName.Name #>GetFormatterHelper.GetOpenGenericFormatter(typeof(T));
<#     } else { #>
			Formatter = <#= ResolverName.Name #>GetFormatterHelper.GetClosedFormatter(typeof(T)) as MsgPack::Formatters.IMessagePackFormatter<T>;
<#     } #>
<# } else if (openGenericRegistrations.Length > 0) { #>
			Formatter = (MsgPack::Formatters.IMessagePackFormatter<T>)<#= ResolverName.Name #>GetFormatterHelper.GetOpenGenericFormatter(typeof(T));
<# } #>
		}
	}

	private static class <#= ResolverName.Name #>GetFormatterHelper
	{
<# if (openGenericRegistrations.Length > 0) { #>
		private static readonly global::System.Collections.Generic.Dictionary<global::System.Type, int> openTypeLookup = new global::System.Collections.Generic.Dictionary<global::System.Type, int>(<#= openGenericRegistrations.Length #>)
		{
<# for(var i = 0; i < openGenericRegistrations.Length; i++) { #>
			{ typeof(<#= openGenericRegistrations[i].DataType.GetQualifiedName(genericStyle: GenericParameterStyle.TypeDefinition) #>), <#= i #> },
<# } #>
		};

		internal static object GetOpenGenericFormatter(global::System.Type t)
		{
			if (t.IsGenericType && openTypeLookup.TryGetValue(t.GetGenericTypeDefinition(), out int openKey))
			{
				switch (openKey)
				{
<#     for(var i = 0; i < openGenericRegistrations.Length; i++) { var x = openGenericRegistrations[i]; #>
					case <#= i #>: return global::System.Activator.CreateInstance(typeof(<#= x.GetFormatterNameForResolver(GenericParameterStyle.TypeDefinition) #>).MakeGenericType(t.GenericTypeArguments));
<#     } #>
					default: return null; // unreachable
				};
			}

			return null;
		}
<# }
   if (constructedRegistrations.Length > 0) { #>
<#     if (openGenericRegistrations.Length > 0) { #>

<#     } #>
		/// <summary>
		/// Finds the formatter by a hash of the requested type's runtime name, without a typeof() of each registered type:
		/// a table of typeof() values would make the runtime create every registered type up front (IL2CPP builds an
		/// Il2CppClass for each, JIT-based runtimes load each), and typeof() checks here would make a JIT load every
		/// registered type when compiling this method.
		/// The caller confirms the type, since another type can have the same runtime name.
		/// </summary>
		internal static object GetClosedFormatter(global::System.Type t)
		{
<# if (keyedRegistrations.Count > 0) { #>
			switch (GetTypeKeyHash(t))
			{
<# foreach (var group in keyedRegistrations) { #>
				case 0x<#= group.Key.ToString("X16") #>UL: return <#= group.Count() == 1 ? $"{ResolverName.Name}FormatterFactory.Create{group.First()}()" : string.Join(" ?? ", group.Select(i => $"{ResolverName.Name}FormatterFactory.Create{i}(t)")) #>;
<# } #>
			}

<# }
   foreach (var i in unkeyedRegistrations) { #>
			if (<#= ResolverName.Name #>FormatterFactory.Create<#= i #>(t) is object formatter<#= i #>)
			{
				return formatter<#= i #>;
			}

<# } #>
			return null;
		}

		/// <summary>
		/// Hashes the namespace-qualified runtime name of a type with 64-bit FNV-1a,
		/// matching what the source generator computed for each registered type.
		/// </summary>
		private static ulong GetTypeKeyHash(global::System.Type t)
		{
			var builder = new global::System.Text.StringBuilder();
			AppendTypeKey(builder, t);
			ulong hash = 14695981039346656037UL;
			for (int i = 0; i < builder.Length; i++)
			{
				hash = (hash ^ builder[i]) * 1099511628211UL;
			}

			return hash;
		}

		private static void AppendTypeKey(global::System.Text.StringBuilder builder, global::System.Type t)
		{
			if (t.IsArray)
			{
				AppendTypeKey(builder, t.GetElementType());
				builder.Append('[').Append(',', t.GetArrayRank() - 1).Append(']');
			}
			else if (t.IsGenericType)
			{
				builder.Append(t.GetGenericTypeDefinition().FullName).Append('[');
				global::System.Type[] arguments = t.GetGenericArguments();
				for (int i = 0; i < arguments.Length; i++)
				{
					if (i > 0)
					{
						builder.Append(',');
					}

					AppendTypeKey(builder, arguments[i]);
				}

				builder.Append(']');
			}
			else
			{
				builder.Append(t.FullName);
			}
		}
<# } #>
	}
<# if (constructedRegistrations.Length > 0) { #>

	/// <summary>
	/// Creates each registered formatter in its own method, so that requesting one formatter only makes the runtime
	/// resolve that formatter's types. A single method that references every formatter forces all of them to load
	/// at once: IL2CPP initializes all metadata a method uses on its first call, and JIT-based runtimes load every
	/// type a method references when compiling it.
	/// Methods that take the requested type are for types that share a key hash with another registered type, or that
	/// have no key: they confirm the type with typeof() and return null for any other type.
	/// This class has no static state, so calling into it never triggers class initialization.
	/// </summary>
	private static class <#= ResolverName.Name #>FormatterFactory
	{
<# for(var i = 0; i < constructedRegistrations.Length; i++) { var x = constructedRegistrations[i]; #>
<#     if (checkedRegistrations.Contains(i)) { #>
		internal static object Create<#= i #>(global::System.Type t) => t == typeof(<#= x.DataType.GetQualifiedName(genericStyle: GenericParameterStyle.Arguments) #>) ? <#= x.GetFormatterInstanceForResolver() #> : null;
<#     } else { #>
		internal static object Create<#= i #>() => <#= x.GetFormatterInstanceForResolver() #>;
<#     } #>
<# } #>
	}
<# } #>
}

<# } #>
